# Neev API configuration. Copy to backend/.env.local and edit for local use.
# Every variable is prefixed with NEEV_. Never commit real secrets.

NEEV_APP_ENV=development
NEEV_DEBUG=true
NEEV_DATABASE_URL=postgresql+psycopg://postgres@/neev?host=/tmp/opencode/pgdata
NEEV_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
NEEV_PUBLIC_BASE_URL=http://127.0.0.1:8000
NEEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Development adapters (refused in production) ---
NEEV_DEV_OTP_ENABLED=true
NEEV_DEV_OTP_FIXED_CODE=123456
NEEV_DEV_OTP_RETURN_CODE=true
NEEV_DEV_AUTO_APPROVE_CAPTAINS=true
NEEV_DEV_ALLOW_GPS_SIMULATION=true
NEEV_PAYMENT_PROVIDER=sandbox
NEEV_SMS_PROVIDER=outbox
NEEV_MAP_PROVIDER=demo

# --- Tokens and limits ---
NEEV_ACCESS_TOKEN_MINUTES=15
NEEV_REFRESH_TOKEN_DAYS=30
NEEV_ADMIN_ACCESS_TOKEN_MINUTES=30
NEEV_OTP_TTL_SECONDS=120
NEEV_OTP_LENGTH=6
NEEV_OTP_MAX_ATTEMPTS=5
NEEV_OTP_RESEND_COOLDOWN_SECONDS=45
NEEV_OTP_REQUESTS_PER_HOUR=8

# --- Dispatch ---
NEEV_DISPATCH_RADIUS_KM=5
NEEV_SEARCH_TIMEOUT_SECONDS=90
NEEV_OFFER_TIMEOUT_SECONDS=45
NEEV_CAPTAIN_STALE_LOCATION_SECONDS=180
NEEV_MAX_OFFERS_PER_REQUEST=8
NEEV_PIN_TTL_MINUTES=30
NEEV_LOCATION_MAX_AGE_SECONDS=180
NEEV_ROUTE_DEVIATION_THRESHOLD_M=500

# --- External providers (production) ---
# NEEV_MAP_PROVIDER=osm
# NEEV_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# NEEV_OSM_OSRM_URL=https://router.project-osrm.org
# NEEV_GEOCODER_USER_AGENT=NeevProduction/1.0 (ops@example.com)
# NEEV_PAYMENT_PROVIDER=razorpay
# NEEV_RAZORPAY_KEY_ID=
# NEEV_RAZORPAY_KEY_SECRET=
# NEEV_RAZORPAY_WEBHOOK_SECRET=
# NEEV_SMS_PROVIDER=twilio
# NEEV_TWILIO_ACCOUNT_SID=
# NEEV_TWILIO_AUTH_TOKEN=
# NEEV_TWILIO_FROM_NUMBER=

# --- Storage and background work ---
NEEV_UPLOAD_DIR=var/uploads
NEEV_MAX_UPLOAD_BYTES=10485760
NEEV_DOCUMENT_URL_TTL_SECONDS=300
NEEV_SHARE_LINK_TTL_MINUTES=240
NEEV_SOS_COOLDOWN_MINUTES=30
NEEV_RUN_BACKGROUND_JOBS=true

# --- Shared infrastructure ---
NEEV_ENABLE_REDIS=false
NEEV_REDIS_URL=redis://localhost:6379/0
