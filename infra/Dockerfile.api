FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system neev \
    && useradd --system --gid neev --home /app neev \
    && mkdir -p /data/uploads \
    && chown -R neev:neev /data

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/ /app/backend/
RUN chown -R neev:neev /app

USER neev
WORKDIR /app/backend

ENV NEEV_UPLOAD_DIR=/data/uploads

EXPOSE 8000

# Migrations run before the server starts so a fresh database is usable.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
